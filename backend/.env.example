# Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# AWS Configuration
# AWS credentials are NOT to be hardcoded here.
# Configure credentials securely via AWS CLI (`aws configure`) or standard AWS environment variables.
AWS_REGION=us-east-1

# Amazon Bedrock Model Configuration
# Available chat models in Amazon Bedrock (ensure model access is enabled in AWS Console):
# - anthropic.claude-3-haiku-20240307-v1:0 (Fast & cost-effective)
# - anthropic.claude-3-5-haiku-20241022-v1:0
# - anthropic.claude-3-5-sonnet-20240620-v1:0
# - amazon.nova-micro-v1:0
# - amazon.nova-lite-v1:0
# - meta.llama3-8b-instruct-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

